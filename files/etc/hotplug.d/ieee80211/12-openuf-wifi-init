#!/bin/sh
# Runs after 10-wifi-detect has written the radio sections. One-shot: once the
# first-boot Wi-Fi setup is done, the flag file makes this a no-op.
[ "${ACTION}" = "add" ] || exit 0
[ -f /etc/openuf/.wifi-init-done ] && exit 0
COUNTRY=US
[ -f /etc/openuf/firstboot.conf ] && . /etc/openuf/firstboot.conf
. /usr/share/openuf-firstboot/wifi-init.sh
openuf_wifi_init "$COUNTRY" >>/root/openuf-firstboot.log 2>&1 && {
	ubus call network reload 2>/dev/null
	wifi reload 2>/dev/null
}
exit 0
