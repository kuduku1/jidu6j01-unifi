#!/bin/sh
# First boot of the JIDU6J01 openUF image: turn the router into a
# UniFi-adoptable access point with no internet and no manual steps.
#
# Runs once (uci-defaults), before netifd/hostapd/dropbear start, so every
# change below simply IS the configuration of the first real boot -- no reboot.
# Log: /root/openuf-firstboot.log

LOG=/root/openuf-firstboot.log
exec >>"$LOG" 2>&1
echo "=== openUF first boot $(date) ==="

CONF=/etc/openuf/firstboot.conf
# Defaults; the build writes the real values into $CONF.
COUNTRY=US
HOSTNAME=JIDU6J01-AP
ADDRESS=dhcp
GATEWAY=
DNS=
INFORM_URL=
TIMEZONE_NAME=Asia/Kolkata
TIMEZONE=IST-5:30
[ -f "$CONF" ] && . "$CONF"

# ── system ────────────────────────────────────────────────────────────────
uci set system.@system[0].hostname="$HOSTNAME"
uci set system.@system[0].zonename="$TIMEZONE_NAME"
uci set system.@system[0].timezone="$TIMEZONE"
uci commit system
echo "hostname $HOSTNAME, timezone $TIMEZONE_NAME"

# ── root password (hash only, baked from the GitHub secret) ───────────────
if [ -s /etc/openuf/.root-hash ]; then
	H=$(cat /etc/openuf/.root-hash)
	case "$H" in
		\$*) sed -i "s|^root:[^:]*:|root:$H:|" /etc/shadow && echo "root password set" ;;
		*) echo "WARNING: root hash file malformed, root password NOT set" ;;
	esac
fi
rm -f /etc/openuf/.root-hash

# ── SSH hardening (adoption still works: it only needs a login + 1 command)
uci set dropbear.main.LocalPortForward='off'
uci set dropbear.main.RemotePortForward='off'
uci commit dropbear

# ── openUF ────────────────────────────────────────────────────────────────
[ -f /etc/config/openuf ] || : > /etc/config/openuf
uci -q get openuf.main >/dev/null || uci set openuf.main=openuf
uci set openuf.main.modelmap='jiorouter-ax6000-jidu6j01'
uci set openuf.main.ufmodel='auto'
uci set openuf.main.country_override="$COUNTRY"
uci set openuf.main.l2_announce='1'
[ -n "$INFORM_URL" ] && uci set openuf.main.inform_url="$INFORM_URL"
uci commit openuf
echo "openuf: modelmap jidu6j01, country_override $COUNTRY${INFORM_URL:+, inform $INFORM_URL}"

# ── Wi-Fi: country, radios on, no open default SSID ───────────────────────
# Shared with /etc/hotplug.d/ieee80211/12-openuf-wifi-init, which finishes
# the job if the radios register after this script runs.
. /usr/share/openuf-firstboot/wifi-init.sh
[ -n "$(uci -q show wireless | grep '=wifi-device$')" ] || /sbin/wifi config
openuf_wifi_init "$COUNTRY" || echo "radios not registered yet; hotplug will finish Wi-Fi setup"

# ── router -> access point ───────────────────────────────────────────────
# WAN socket joins br-lan, LAN takes DHCP (or the static address given),
# DHCP server / firewall / dnsmasq / odhcpd off. Reversible: openuf-convert --revert
set -- --convert --address "$ADDRESS"
[ -n "$GATEWAY" ] && set -- "$@" --gateway "$GATEWAY"
[ -n "$DNS" ] && set -- "$@" --dns "$DNS"
if /usr/sbin/openuf-convert "$@"; then
	echo "converted to access point ($ADDRESS)"
else
	echo "ERROR: openuf-convert failed; the device stays a router at 192.168.1.1"
fi

# ── zero-touch L2 adoption account (ubnt/ubnt, restricted, self-locking) ──
sh /usr/lib/openuf/hook/openuf-bootstrap.sh || echo "WARNING: bootstrap account not usable"

# ── services ───────────────────────────────────────────────────────────────
/etc/init.d/lldpd enable
/etc/init.d/openuf enable

echo "=== first boot setup done ==="
exit 0
